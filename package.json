{
  "name": "playwrightgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:authorization": "playwright test",
    "test:database": "vitest run tests/integration/database-schema.test.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@upstash/redis": "^1.36.4",
    "cheerio": "^1.2.0",
    "dotenv": "17.4.2",
    "jszip": "^3.10.1",
    "next": "16.1.6",
    "openai": "^6.27.0",
    "pg": "8.23.0",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-syntax-highlighter": "^16.1.1",
    "resend": "^6.9.3",
    "server-only": "0.0.1",
    "stripe": "^20.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.23.11",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
